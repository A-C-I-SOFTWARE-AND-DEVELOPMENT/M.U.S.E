{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && bash \"$CLAUDE_PROJECT_DIR/.claude/skills/muse-quality/scripts/fast_check.sh\" \"$f\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
