# .dockerignore — excluded from Docker build context
# Reduces image size and build time by skipping unnecessary files

# Version control
.git
.gitignore
.gitattributes

# CI/CD
.github/

# Generated outputs
final_pipeline_output/
final_proof_game/
toolchain_output/
frontier_hunt_*/
.orchestrate/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
.npm

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Docs (built in container if needed)
docs/_build/
docs/_generated/

# Tests (not needed in production image)
tests/
testlogs/

# Temp files
tmp/
temp_*/
*.log
