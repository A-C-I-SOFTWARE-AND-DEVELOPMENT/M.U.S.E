; Engine configuration file.
; Game Studio reference vertical slice — Godot 4.x
; Forward+ renderer for SOTA lighting (SDFGI / SSAO / SSR / glow).

config_version=5

[application]

config/name="muse Game Studio — Vertical Slice"
config/description="Reference playable vertical slice produced by the muse game-studio skill."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

