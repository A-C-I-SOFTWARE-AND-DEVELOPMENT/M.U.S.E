{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Operating Registry",
  "type": "object",
  "required": [
    "version",
    "purpose",
    "source_of_truth",
    "policies",
    "active_council",
    "domain_specialists",
    "super_specialist_skills",
    "worker_templates",
    "separated_collections"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "object"
    },
    "policies": {
      "type": "object"
    },
    "active_council": {
      "type": "array",
      "maxItems": 6
    },
    "domain_specialists": {
      "type": "array"
    },
    "super_specialist_skills": {
      "type": "array"
    },
    "worker_templates": {
      "type": "array"
    },
    "separated_collections": {
      "type": "object"
    }
  }
}
