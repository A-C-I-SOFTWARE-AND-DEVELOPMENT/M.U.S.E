{
  "schema": "hermes.merge.scorecard.v1",
  "categories": [
    "correctness",
    "completeness",
    "testability",
    "maintainability",
    "repo_fit",
    "architecture_fit",
    "risk_control",
    "ux_quality",
    "speed",
    "cost_efficiency",
    "local_first_fit",
    "jeremiah_fit"
  ],
  "winner": "<worker_id or null>",
