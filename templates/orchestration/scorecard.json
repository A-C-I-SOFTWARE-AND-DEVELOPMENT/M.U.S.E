      "changed_file_count": 0,
      "notes": [],
      "flags": [],
      "scores": {
        "correctness": 0.0,
        "completeness": 0.0,
        "testability": 0.0,
        "maintainability": 0.0,
        "repo_fit": 0.0,
        "architecture_fit": 0.0,
        "risk_control": 0.0,
        "ux_quality": 0.0,
        "speed": 0.0,
        "cost_efficiency": 0.0,
        "local_first_fit": 0.0,
        "jeremiah_fit": 0.0
      },
      "total": 0.0,
      "weighted_total": 0.0
    }
  ],
  "rejected": [
    {
      "worker_id": "<worker_id>",
      "profile": "<model or agent label>",
      "reason": "<short reason>",
      "score": 0.0
    }
  ],
  "conflicts": [
    {
