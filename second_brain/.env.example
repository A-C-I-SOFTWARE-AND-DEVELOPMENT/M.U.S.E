# ===========================================================================
# Second Brain — example environment configuration.
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# Every variable has a safe default in code; only override what you need.
# ===========================================================================

# --- Logging ---
SECOND_BRAIN_LOG_LEVEL=INFO

# --- PostgreSQL + pgvector (Layer 2) ---
SECOND_BRAIN_PG_HOST=localhost
SECOND_BRAIN_PG_PORT=5432
SECOND_BRAIN_PG_DB=second_brain
SECOND_BRAIN_PG_USER=second_brain
SECOND_BRAIN_PG_PASSWORD=change-me-postgres
SECOND_BRAIN_PG_SSLMODE=prefer
SECOND_BRAIN_PG_MIN_CONN=1
SECOND_BRAIN_PG_MAX_CONN=8

# --- Neo4j (Layer 2) ---
SECOND_BRAIN_NEO4J_URI=bolt://localhost:7687
SECOND_BRAIN_NEO4J_USER=neo4j
SECOND_BRAIN_NEO4J_PASSWORD=change-me-neo4j
SECOND_BRAIN_NEO4J_DB=neo4j
SECOND_BRAIN_NEO4J_POOL=16

# --- Embeddings (Layer 1) ---
# provider: hashing | sentence-transformers | openai
SECOND_BRAIN_EMBEDDING_PROVIDER=hashing
SECOND_BRAIN_EMBEDDING_MODEL=deterministic-hash-v1
# MUST match the vector(N) dimension in migrations/001_init.sql.
SECOND_BRAIN_EMBEDDING_DIM=1536
SECOND_BRAIN_EMBEDDING_BATCH=64
# Only read by the OpenAI provider's client; never stored by this module.
# OPENAI_API_KEY=sk-...

# --- Chunking (Layer 1) ---
SECOND_BRAIN_CHUNK_TARGET=320
SECOND_BRAIN_CHUNK_OVERLAP=64
SECOND_BRAIN_CHUNK_MIN=32
SECOND_BRAIN_CHUNK_MAX_ENTITIES=32

# --- Retrieval & ranking (Layer 3) ---
SECOND_BRAIN_TOP_K=8
SECOND_BRAIN_GRAPH_HOPS=2
SECOND_BRAIN_GRAPH_LIMIT=32
SECOND_BRAIN_TOKEN_BUDGET=4096
SECOND_BRAIN_W_SIMILARITY=0.5
SECOND_BRAIN_W_CONFIDENCE=0.3
SECOND_BRAIN_W_RECENCY=0.2
SECOND_BRAIN_RECENCY_HALFLIFE=30
SECOND_BRAIN_KEYWORD_FALLBACK=1
SECOND_BRAIN_KEYWORD_THRESHOLD=3

# --- Governance & lifecycle (Layer 5) ---
SECOND_BRAIN_TTL_DAYS=180
SECOND_BRAIN_CONF_HALFLIFE=90
SECOND_BRAIN_CONF_FLOOR=0.05
SECOND_BRAIN_CONF_CEILING=0.97
SECOND_BRAIN_REINFORCE_BOOST=0.05
SECOND_BRAIN_REINFORCE_TTL=30
SECOND_BRAIN_CONSOLIDATE_SIM=0.95
SECOND_BRAIN_REFRESH_DAYS=30
SECOND_BRAIN_EXPIRY_FLOOR=0.1
