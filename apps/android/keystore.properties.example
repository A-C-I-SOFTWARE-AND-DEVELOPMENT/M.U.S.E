# Release signing for the Jarvis Prime Android app.
#
# Copy this file to `apps/android/keystore.properties` (which is gitignored)
# and fill in your own values to build a signed release APK locally:
#
#     cp keystore.properties.example keystore.properties
#     # edit keystore.properties
#     ./gradlew :app:assembleRelease
#
# NEVER commit keystore.properties or the .jks/.keystore file. CI signs from
# GitHub Actions secrets instead (see docs/RELEASE_SIGNING.md), so these
# property names each have an environment-variable equivalent used in CI:
#
#   storeFile     <- ANDROID_KEYSTORE_FILE
#   storePassword <- ANDROID_KEYSTORE_PASSWORD
#   keyAlias      <- ANDROID_KEY_ALIAS
#   keyPassword   <- ANDROID_KEY_PASSWORD
#
# If none of these are set, the release build falls back to debug signing so
# it still produces an installable (debug-signed) APK.

storeFile=/absolute/path/to/jarvis-release.jks
storePassword=changeme
keyAlias=jarvis
keyPassword=changeme
