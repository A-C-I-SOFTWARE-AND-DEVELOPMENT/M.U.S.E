<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Reaching the user's own local Hermes gateway (default
         http://127.0.0.1:8765) over loopback/LAN requires INTERNET — Android
         gates every socket, including localhost, behind this permission.
         Used ONLY to talk to the paired local gateway; never to remote AI
         providers, and no provider API keys ever live in this app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Install the downloaded MUSE update APK through the system package
         installer (the visible OS "Install/Update" dialog). Used only by the
         in-app "install update" action; never a silent or background install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Sentient avatar: the body lives over other apps and operates the
         device; the voice loop listens through a headset. These are the
         power-user permissions the personal-tool fork opts into. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Opt-in camera attention for Presence Mode (default OFF). Used only
         for on-device face-PRESENCE detection to arm hands-free listening
         when the user looks at the phone, and only while the live screen is
         visible with a camera indicator shown. No frames are stored or
         transmitted; ML Kit runs fully on-device. The camera is optional
         hardware so the app still installs on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".HermesApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HermesAgent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HermesAgent.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".service.HermesService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Polls the cockpit for long-running-work state changes and posts
             local notifications. Runs only while active work exists; self-stops
             when idle (see WorkWatchService). -->
        <service
            android:name=".service.WorkWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The floating avatar body (draws over other apps). -->
        <service
            android:name=".service.JarvisOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_screen_assistant_avatar" />
        </service>

        <!-- The hands-free voice loop. -->
        <service
            android:name=".service.VoiceLoopService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Jarvis' hands: performs taps/swipes and launches apps. -->
        <service
            android:name=".service.JarvisAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/jarvis_accessibility" />
        </service>

        <!-- Hands the downloaded update APK to the system package installer via
             a content:// URI (never a raw file:// path). Used by ApkInstaller. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
