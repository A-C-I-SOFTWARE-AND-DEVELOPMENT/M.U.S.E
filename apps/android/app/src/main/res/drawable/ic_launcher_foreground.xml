<?xml version="1.0" encoding="utf-8"?>
<!--
  muse adaptive launcher icon — foreground layer.

  108dp x 108dp viewport, 66dp safe zone (centred at 54,54).

  Composition:
    - Outer authority ring (gold, hairline)
    - Inner cyan ring (listening / scanning)
    - "J" monogram, semi-bold geometric form
    - Single gold "prime dot" above the J — the watchful eye
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer authority ring (gold) -->
    <path
        android:strokeColor="#E6B341"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M54,21 m -30,0 a 30,30 0 1,0 60,0 a 30,30 0 1,0 -60,0" />

    <!-- Inner listening ring (cyan, dimmer) -->
    <path
        android:strokeColor="#38C6E0"
        android:strokeWidth="0.75"
        android:fillColor="#00000000"
        android:pathData="M54,54 m -24,0 a 24,24 0 1,0 48,0 a 24,24 0 1,0 -48,0" />

    <!-- "J" — vertical stem, semi-bold -->
    <path
        android:fillColor="#E6B341"
        android:pathData="M53,38 h4 v28 c0,4 -3,7 -7,7 c-4,0 -7,-3 -7,-7 v-2 h4 v2 c0,2 1.5,3 3,3 c1.5,0 3,-1 3,-3 z" />

    <!-- Prime dot above the J — the watchful eye -->
    <path
        android:fillColor="#E6B341"
        android:pathData="M55,32 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />

</vector>
