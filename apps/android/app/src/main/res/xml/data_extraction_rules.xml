<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis Prime intentionally excludes every persistent module's storage
  from cloud backup and device transfer. Memory tree, audit log, and
  the encrypted preferences from the Hermes era are all device-local
  by design — they are not portable between devices, and the audit log
  is meant to be a record of what happened on this device specifically.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hermes_secure_prefs.xml" />
        <exclude domain="sharedpref" path="jarvis_memory_v1.preferences_pb" />
        <exclude domain="file" path="jarvis_audit/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hermes_secure_prefs.xml" />
        <exclude domain="sharedpref" path="jarvis_memory_v1.preferences_pb" />
        <exclude domain="file" path="jarvis_audit/" />
    </device-transfer>
</data-extraction-rules>
