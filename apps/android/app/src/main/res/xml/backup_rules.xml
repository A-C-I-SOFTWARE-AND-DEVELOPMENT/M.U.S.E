<?xml version="1.0" encoding="utf-8"?>
<!--
  Same exclusions as data_extraction_rules.xml, applied to legacy
  Android <12 backup. Jarvis Prime stores its memory + audit log as
  device-local data and never round-trips them through a backup
  provider.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="hermes_secure_prefs.xml" />
    <exclude domain="sharedpref" path="jarvis_memory_v1.preferences_pb" />
    <exclude domain="file" path="jarvis_audit/" />
</full-backup-content>
