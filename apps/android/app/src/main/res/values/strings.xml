    <!-- Onboarding / setup -->
    <string name="setup_welcome_title">Welcome to Hermes</string>
    <string name="setup_welcome_subtitle">The self-improving AI agent built by Nous Research — now on your phone.</string>
    <string name="setup_companion_note">This Android app is a native companion for Hermes. The agent\'s heavy lifting runs against a Hermes gateway you connect to (local Termux instance, home server, or remote VPS). You can also use mock mode to explore the UI without a backend.</string>
