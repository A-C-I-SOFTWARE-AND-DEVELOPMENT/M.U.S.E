    <string name="settings_local_only_mode_subtitle">On by default. All orchestrator state stays on this device.</string>
    <string name="settings_allow_external_label">Allow external app opening</string>
    <string name="settings_allow_external_subtitle">When on, Jarvis Prime can launch the official app or browser fallback. Each launch still requires a tap.</string>
