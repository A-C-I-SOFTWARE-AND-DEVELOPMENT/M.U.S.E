    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Jarvis Prime</string>
    <string name="onboarding_welcome_body">Jarvis Prime is your mobile-first AI operating partner. It plans, drafts, reviews, and asks before acting. It runs on your phone and respects your boundaries.</string>
    <string name="onboarding_safety_title">How Jarvis Prime treats permissions</string>
    <string name="onboarding_safety_body">Jarvis Prime never reads SMS, never reads your call log, and never asks to draw over other apps. The microphone is only turned on after you tap voice. Risky asks are confirmed once. Critical asks require an impact report and two confirmations.</string>
    <string name="onboarding_notifications_title">Notification updates</string>
    <string name="onboarding_notifications_body">When Jarvis Prime is on watch, a quiet, ongoing notification lets you check status at a glance and reach the emergency stop. You can enable this now or later from settings.</string>
    <string name="onboarding_notifications_allow">Enable status notification</string>
    <string name="onboarding_notifications_skip">Maybe later</string>
    <string name="onboarding_voice_title">Voice, only when you ask</string>
    <string name="onboarding_voice_body">The mic stays off until you press the voice button. There is no always-listening mode.</string>
    <string name="onboarding_done">Continue to Jarvis Prime</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_next">Continue</string>
    <string name="onboarding_back">Back</string>

