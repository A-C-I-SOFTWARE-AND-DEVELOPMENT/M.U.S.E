    <string name="home_quick_links">Quick links</string>
    <string name="home_status_mode_value">Local Subscription Tools</string>

    <!-- Tasks tab -->
    <string name="tasks_empty_title">No tasks yet</string>
    <string name="tasks_empty_body">Tap the New task button to draft a brief, generate a prompt, and hand it off to Codex or Claude Code.</string>

    <!-- Chat placeholder -->
    <string name="chat_title">Chat</string>
    <string name="chat_description">A focused thread surface for talking to Jarvis Prime about the active task.</string>
    <string name="chat_coming_soon">The conversational pane is still being built. Until then, use Prepare handoff on the Home screen to draft a prompt for your tool of choice.</string>

    <!-- Approvals placeholder -->
    <string name="approvals_title">Approvals</string>
    <string name="approvals_description">Review and approve actions Jarvis Prime wants to take on your behalf.</string>
    <string name="approvals_coming_soon">Pending-approval queue ships with the next milestone. Run actions manually for now.</string>

    <!-- Memory placeholder -->
    <string name="memory_title">Memory</string>
    <string name="memory_description">Inspect long-term context, facts, and preferences Jarvis Prime has on file for you.</string>
    <string name="memory_coming_soon">Memory inspection arrives once the local store is wired up. Tasks remain visible on the Tasks tab.</string>

    <!-- Audit placeholder -->
    <string name="audit_title">Audit</string>
    <string name="audit_description">A chronological log of every decision, handoff, and approval Jarvis Prime made on this device.</string>
    <string name="audit_coming_soon">Audit timeline lands next. Use Diagnostics for the raw service log in the meantime.</string>

