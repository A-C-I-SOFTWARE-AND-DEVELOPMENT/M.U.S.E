    <string name="provider_title">AI Connection</string>
    <string name="provider_mode_heading">Choose a connection mode</string>

    <string name="mode_mock_short">Mock</string>
    <string name="mode_direct_short">Direct API</string>
    <string name="mode_hermes_short">Hermes</string>

    <string name="mode_mock_description">No backend. The app replies with canned sample responses — useful for trying the UI without configuring anything.</string>
    <string name="mode_direct_description">Your phone calls an AI provider (OpenRouter, OpenAI, or a custom OpenAI-compatible endpoint) directly with an API key you paste below. Recommended for personal use.</string>
    <string name="mode_hermes_description">Your phone talks to a Hermes gateway you run somewhere (home server, VPS, Termux on this device). The gateway handles skills, memory, tools, and provider keys server-side.</string>

    <string name="provider_gateway_label">Gateway URL</string>
    <string name="provider_gateway_hint">https://hermes.example.com (real phone) or http://10.0.2.2:8080 (emulator)</string>
    <string name="provider_gateway_setup_note">Setup notes:\n• Android emulator → host: http://10.0.2.2:8080\n• Real phone, same Wi-Fi: http://&lt;LAN-IP-of-host&gt;:8080 (e.g. http://192.168.1.42:8080)\n• Anywhere else: an ngrok / Cloudflare tunnel or a public HTTPS URL.\nProduction gateways must use HTTPS. Gateway tokens and GitHub tokens stay server-side in ~/.hermes/.env — never paste them into the app.</string>
