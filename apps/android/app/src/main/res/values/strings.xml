    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to Jarvis Prime</string>
    <string name="onboarding_subtitle">Your private, on-device command center.</string>
    <string name="onboarding_page1_title">Local-first by design</string>
    <string name="onboarding_page1_body">Jarvis Prime never proxies your OpenAI or Anthropic logins. It organizes work for the tools you already pay for, on your device.</string>
    <string name="onboarding_page2_title">Permissions are optional</string>
    <string name="onboarding_page2_body">Nothing is requested up front. Notifications, voice and other permissions are explained when you choose to use them — and you can skip them all and still use Jarvis Prime.</string>
    <string name="onboarding_page3_title">Approvals stay with you</string>
    <string name="onboarding_page3_body">Risky actions wait for your approval. Serious actions take two taps. Critical actions show an impact report before anything moves.</string>
    <string name="onboarding_page4_title">You always have a kill switch</string>
    <string name="onboarding_page4_body">Emergency Stop halts every queued action instantly. Diagnostics, audit and memory tools are always one screen away.</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_get_started">Enter command center</string>

