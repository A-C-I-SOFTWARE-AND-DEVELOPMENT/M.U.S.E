    <string name="voice_capture_button">Voice</string>
    <string name="voice_education_title">Voice capture</string>
    <string name="voice_education_body">Tap Allow to grant microphone access. Hermes will record only while the listening screen is open — there is no always-on listening and no wake word.</string>
    <string name="voice_education_invariants">What you say becomes editable text. Vague or serious commands (delete, deploy, publish, spend) are never executed automatically — they turn into a draft task that needs your explicit approval.</string>
    <string name="voice_education_no_stt">No on-device speech recogniser is installed. You can still type a transcript on the next screen.</string>
    <string name="voice_allow_microphone">Allow microphone</string>
    <string name="voice_requesting_permission_title">Requesting microphone…</string>
    <string name="voice_requesting_permission_body">Android is showing the permission prompt. Choose While using the app.</string>
    <string name="voice_permission_denied_title">Microphone permission denied</string>
    <string name="voice_permission_denied_body">Voice capture needs microphone access while the sheet is open. You can retry, or cancel and type the request instead.</string>
    <string name="voice_permission_denied_permanent">Microphone permission is blocked in system settings. Enable it in Settings → Apps → Hermes Agent → Permissions to use voice capture.</string>
