    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to Jarvis Prime</string>
    <string name="onboarding_subtitle">A local orchestration shell for the AI tools you already use. Nothing leaves this device unless you say so.</string>
    <string name="onboarding_bullet_local_title">Local-first</string>
    <string name="onboarding_bullet_local_body">All tasks, prompts, and preferences live on this device. No backend, no API key required.</string>
    <string name="onboarding_bullet_handoff_title">Tool handoff, not proxy</string>
    <string name="onboarding_bullet_handoff_body">Jarvis Prime prepares prompts and hands off to the official Codex, ChatGPT, Claude Code, or Claude apps you already use.</string>
    <string name="onboarding_bullet_safety_title">Emergency stop, always</string>
    <string name="onboarding_bullet_safety_body">The orchestrator runs as a foreground service so you always know it is on, and a global Emergency Stop is one tap away from any screen.</string>
    <string name="onboarding_cta">Get started</string>
    <string name="onboarding_skip">Skip</string>

    <!-- Home -->
    <string name="home_greeting_title">Mission control</string>
