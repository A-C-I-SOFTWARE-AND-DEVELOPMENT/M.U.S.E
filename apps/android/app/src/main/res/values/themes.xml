<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Jarvis Prime base theme. The Compose layer owns the color
         scheme — these system styles only paint the window
         decorations and the splash background. -->
    <style name="Theme.JarvisPrime" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/jarvis_ink</item>
    </style>

    <style name="Theme.JarvisPrime.Splash" parent="Theme.JarvisPrime">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Compat aliases so any reference to the old Hermes Agent style
         IDs continues to resolve during the brand transition. -->
    <style name="Theme.HermesAgent" parent="Theme.JarvisPrime" />
    <style name="Theme.HermesAgent.Splash" parent="Theme.JarvisPrime.Splash" />
</resources>
