# NEXUS environment configuration. Copy to `.env` and fill in.
#
# ── KEY-PREFIX CONVENTION (read this first) ─────────────────────────────────
# Vite only exposes variables that start with `VITE_` to the browser bundle.
# Anything WITHOUT that prefix stays server-side (read via `process.env`) and is
# never shipped to the client. So:
#   • Secrets / provider API keys  → NO `VITE_` prefix  → server-only.
#   • Public client config         → `VITE_` prefix     → safe in the browser.
# Never give a server secret a `VITE_` prefix: doing so leaks it into the
# client bundle that any visitor can download.

# ════════════════════════════════════════════════════════════════════════════
# SERVER-ONLY KEYS  (NO `VITE_` prefix — read from process.env, never sent to
# the browser). Set these on the host/Vercel as plain env vars, NOT as build-
# time VITE_ vars. Consumed by the provider gateway (server/provider-gateway.mjs)
# and the /api/* serverless functions.
# ════════════════════════════════════════════════════════════════════════════

# Primary LLM provider — OpenRouter (routes to many models). SERVER-ONLY.
OPENROUTER_API_KEY=

# Additional model providers (used when routing directly). SERVER-ONLY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase JWT signing secret — used server-side to verify/issue auth tokens.
# SERVER-ONLY. This is NOT the anon key; it must never reach the browser.
SUPABASE_JWT_SECRET=

# ════════════════════════════════════════════════════════════════════════════
# CLIENT KEYS  (`VITE_` prefix — bundled into the browser, publicly visible).
# Only put values here that are safe to expose to every visitor.
# ════════════════════════════════════════════════════════════════════════════

# Supabase project URL + anon (public) key. Safe for the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- M.U.S.E. backend (the deep integration) ---
# Base URL of your M.U.S.E. gateway. Leave empty for honest empty states.
VITE_MUSE_BASE_URL=

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# (Private key lives ONLY on the M.U.S.E. backend / server, never in the PWA.)
