# NEXUS environment configuration. Copy to `.env` and fill in.

# --- M.U.S.E. backend (the deep integration) ---
# Base URL of your M.U.S.E. gateway. Leave empty for honest empty states.
VITE_MUSE_BASE_URL=

# --- Supabase (auth + persistence: push subscriptions, profiles) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# (Private key lives ONLY on the M.U.S.E. backend, never in the PWA.)
