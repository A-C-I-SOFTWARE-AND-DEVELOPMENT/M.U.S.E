# NEXUS console install policy.
#
# vite was bumped to ^8 while @vitejs/plugin-react is still on the 4.x line,
# whose peer range tops out at vite 7 (^4.2.0 || ^5 || ^6 || ^7). plugin-react
# 4.7 works fine on vite 8 in practice — the range simply lags — but npm's
# strict peer check makes `npm ci` hard-fail with ERESOLVE, which broke the
# "Deploy NEXUS to Pages" workflow. The lockfile already pins a valid tree
# (vite 8.0.16 + plugin-react 4.7.0 coexisting), so relaxing the peer check
# changes nothing about what installs — it only stops the spurious abort.
#
# Remove this once @vitejs/plugin-react is upgraded to ^5 (which widens the
# peer range to include vite 8) and the lockfile is regenerated.
legacy-peer-deps=true
