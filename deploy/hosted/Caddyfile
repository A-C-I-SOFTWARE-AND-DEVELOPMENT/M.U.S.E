# Caddyfile — hosted muse gateway fleet (the "commercially available" compute).
#
# One VPS runs one cockpit container per Pro user (docker-compose.hosted.yml),
# each publishing 127.0.0.1:<PUB_PORT>. This reverse proxy terminates TLS for
# gw.musehq.io and routes /u/<slug>/* to the matching container. The Vercel
# relay (api/gateway/[...path].ts) is the only caller — it attaches each
# account's gateway bearer server-side — so this proxy does NOT add CORS
# (relay traffic is server-to-server; the cockpit's own default CORS already
# covers direct browser use of musehq.io).
#
# Per-user routes are generated by scripts/fleet/provision_user.sh, which
# appends a `handle_path` block per user (or you can template it as below).
# Reload with: sudo systemctl reload caddy
#
# __GW_DOMAIN__   public hostname for the fleet, e.g. gw.musehq.io

__GW_DOMAIN__ {
	# Strip the /u/<slug> prefix and forward the remainder to that user's
	# container. The cockpit inside binds loopback (execute lanes enabled) and
	# is exposed on the published port by socat (docker/start-cockpit.sh).
	#
	# --- BEGIN per-user routes (managed by provision_user.sh) ---
	# Example (one block per provisioned user):
	# handle_path /u/jeremiah/* {
	# 	# Fail closed unless the Vercel relay proves its server identity.
	# 	# MUSE_GATEWAY_RELAY_TOKEN must be the same high-entropy value in
	# 	# Caddy's environment and the Vercel project (never VITE_-prefixed).
	# 	@relayGet {
	# 		method GET
	# 		header X-Muse-Relay-Authorization "Bearer {$MUSE_GATEWAY_RELAY_TOKEN}"
	# 		path /v1/health /v1/cockpit/runtime/status /v1/cockpit/runtime/workers /v1/cockpit/capabilities /v1/cockpit/models /v1/cockpit/models/catalog /v1/cockpit/models/local /v1/cockpit/model-routes /v1/cockpit/jobs /v1/cockpit/jobs/* /v1/cockpit/approvals /v1/cockpit/schedules /v1/cockpit/seats /v1/cockpit/audit /v1/cockpit/events /v1/cockpit/events/stream /v1/observatory/*
	# 	}
	# 	@relayPost {
	# 		method POST
	# 		header X-Muse-Relay-Authorization "Bearer {$MUSE_GATEWAY_RELAY_TOKEN}"
	# 		path /v1/cockpit/pair/start /v1/cockpit/pair/confirm /v1/cockpit/service-tokens /v1/cockpit/model-routes/override /v1/cockpit/jobs /v1/cockpit/jobs/* /v1/cockpit/approvals/* /v1/cockpit/emergency-stop /v1/cockpit/orchestrate /v1/cockpit/coding/* /v1/agent/chat /v1/agent/approvals /v1/agent/stop /v1/observatory/recommendations/*/stage
	# 	}
	# 	handle @relayGet {
	# 		reverse_proxy 127.0.0.1:8801 {
	# 			header_up -X-Muse-Relay-Authorization
	# 			flush_interval -1
	# 		}
	# 	}
	# 	handle @relayPost {
	# 		reverse_proxy 127.0.0.1:8801 {
	# 			header_up -X-Muse-Relay-Authorization
	# 			flush_interval -1
	# 		}
	# 	}
	# 	respond "not found" 404
	# }
	# --- END per-user routes ---

	# Unmatched paths: opaque 404 (don't reveal which slugs exist).
	handle {
		respond "not found" 404
	}

	# Security headers (defense in depth; the bearer is the real gate).
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
