# ── n8n stack secrets (generate with: openssl rand -hex 24) ──────────────
POSTGRES_USER=muse
POSTGRES_PASSWORD=change-me-generate-with-openssl
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-generate-with-openssl
GENERIC_TIMEZONE=America/New_York
WEBHOOK_URL=http://localhost:5678/

# ── MUSE ↔ n8n bridge (host side reaches n8n; workflows reach the cockpit) ─
# Cockpit base URL as seen FROM INSIDE the n8n container (Docker Desktop/WSL2):
MUSE_COCKPIT_URL=http://host.docker.internal:8765
# n8n base URL as seen from the host (the delegate bridge) and from workflows:
MUSE_N8N_BASE=http://localhost:5678
# Cockpit bearer token — printed by `muse cockpit serve` / `muse omni`
# (source: gateway/cockpit/auth.py::load_or_create_token). NEVER commit the real value.
MUSE_COCKPIT_TOKEN=
