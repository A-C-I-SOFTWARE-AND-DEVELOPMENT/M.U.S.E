      "name": "Connector: gmail-send",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        140
      ],
      "webhookId": "muse-connector-gmail-send"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body=$json.body??$json;\nconst key=body.idempotency_key || ($json.headers && $json.headers['idempotency-key']) || '';\nconst store=$getWorkflowStaticData('global'); store.seen=store.seen||{};\nconst duplicate = !!(key && store.seen[key]);\nif(key && !duplicate) store.seen[key]=Date.now();\nreturn [{json:{ok:true,duplicate,idempotency_key:key,connector:'gmail-send',verified_by:body.verified_by??null,payload:body.payload??{}}}];"
      },
