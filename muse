#!/usr/bin/env python3
"""
muse CLI launcher with sync subcommand.

This wrapper behaves like the installed `muse` command, including
subcommands such as `gateway`, `cron`, `doctor`, and `sync`.
"""

import sys
import subprocess
import os

def run_sync():
    """Run the auto-sync script."""
    script_path = "/data/data/com.termux/files/home/muse_auto_sync.py"
    if os.path.exists(script_path):
        result = subprocess.run([sys.executable, script_path])
        return result.returncode
    else:
        print("Error: muse_auto_sync.py not found")
        return 1

def main():
    # Handle sync subcommand
    if len(sys.argv) > 1 and sys.argv[1] == "sync":
        sys.exit(run_sync())

    # Otherwise delegate to hermes_cli.main
    from hermes_cli.main import main as hermes_main
    hermes_main()

if __name__ == "__main__":
    main()