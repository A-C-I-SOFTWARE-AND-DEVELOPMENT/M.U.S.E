# Private keys
*.ppk
*.pem
privvy*

# Android signing — NEVER commit a keystore or its passwords.
*.jks
*.keystore
apps/android/keystore.properties
keystore.properties
images/
__pycache__/
hermes_agent.egg-info/
wandb/
testlogs

# CLI config (may contain sensitive SSH paths)
cli-config.yaml

# Skills Hub state (lives in ~/.hermes/skills/.hub/ at runtime, but just in case)
skills/.hub/
ignored/
.worktrees/
# Isolated git worktrees created by background coding agents — transient,
# never committed.
.claude/worktrees/
environments/benchmarks/evals/

# Web UI build output
hermes_cli/web_dist/

# Web UI assets — synced from @nous-research/ui at build time via
# `npm run sync-assets` (see web/package.json).
web/public/fonts/
web/public/ds-assets/

# Release script temp files
.release_notes.md
mini-swe-agent/

# Nix
.direnv/
.nix-stamps/
result
website/static/api/skills-index.json
models-dev-upstream/
hermes_cli/tui_dist/*
hermes_cli/scripts/
docs/superpowers/*

# Hermes orchestrator runtime state (per-run radar requests, etc.).
# Individual radar reports can be force-added with `git add -f` when
# they need to live in version control as an audit trail.
.hermes-orchestrator/

# TokenJuice raw tool-output debug log + local rule overlay. The raw log
# normally lives under ~/.hermes/tool-raw/, but guard against HERMES_HOME being
# pointed at the repo. Never commit captured raw output (may contain secrets).
tool-raw/
.tokenjuice/
# Layered-memory raw event log (provenance-bearing; may contain sensitive
# content). Lives under ~/.hermes/memory-raw/ — guard against repo HERMES_HOME.
memory-raw/
# Research-fabric runtime index (SQLite). Default path is
# <repo>/artifacts/research_fabric/ when --repo-root is the repo; the
# tamper-evident ledger lives under ~/.hermes/. Never commit either.
artifacts/research_fabric/

# Built APKs are delivered as CI artifacts / release assets, not via git
*.apk

# Python build artifacts (uv build / setuptools)
/build/

# muse-quality pipeline outputs (regenerated by scripts/CI; never hand-edited)
docs/_generated/
docs/_build/
# same outputs under any nested package (e.g. the vendored axiom/ kernel)
**/docs/_generated/
**/docs/_build/

# devcontainer / Codespaces local dev home (HERMES_HOME=.hermes-dev) — may hold .env secrets
.hermes-dev/
studio_output/
studio_output*/

# Vercel cockpit build output (assembled by scripts/deploy/build_cockpit_vercel.sh)
cockpit-dist/

# muse Game Studio — these are source files that legitimately match the broad
# `export*` ignore above; force them back into version control.
!skills/creative/game-studio/scripts/export_godot_slice.py
!skills/creative/game-studio/reference-slice/export_presets.cfg
