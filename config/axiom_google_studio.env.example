# Axiom Google Studio configuration example
# Copy values into C:/Users/Echer/AppData/Local/hermes/.env or source this file before --real runs.

# Required for real Vertex AI calls
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Preferred auth: service account with Vertex AI User + Storage Object Admin on the output bucket.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/Echer/AppData/Local/hermes/secrets/google-vertex-sa.json

# Model pins. Keep explicit so production output is reproducible and costs are reviewable.
GOOGLE_IMAGEN_MODEL=imagen-4.0-generate-preview-06-06
GOOGLE_VEO_MODEL=veo-3.0-generate-preview

# Strongly recommended for Veo outputs; Vertex often writes generated videos to GCS.
GOOGLE_VEO_GCS_BUCKET=gs://your-veo-output-bucket
